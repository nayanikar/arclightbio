# See https://help.github.com/articles/ignoring-files/

# --- Dependencies ---
/node_modules
/.pnp
.pnp.js
.pnp.*
.yarn/install-state.gz

# --- Next.js / build output ---
/.next/
/out/
/build
/dist
.turbo

# --- Environment & secrets (never commit) ---
.env
.env.*
!.env*.example
!.env.example

# --- TypeScript ---
*.tsbuildinfo

# --- Test & coverage ---
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# --- Logs & debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# --- OS & editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# --- Cursor (local IDE / agent state) ---
.cursor/

# --- Local runtime data (file-store mode when Supabase is not configured) ---
/.data/

# --- Spacebase enrollment keys & session state ---
/.spacebase/

# --- Vercel ---
.vercel

# --- Python (Spacebase helper scripts) ---
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/

# --- Local audit & verification artifacts (E2E screenshots, agent scratch) ---
.audit-tmp/
.playwright-audit/
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif
**/*.png
**/*.jpg
**/*.jpeg
**/*.webp
**/*.gif
!public/marketing/
!public/marketing/**

# --- Accidental npm artifact filenames ---
arclight-bio@*
11.16.0
/next

# --- Docs & specs (not required to run the app; keep locally or in wiki) ---
/issues.md
/index.md
/opportunity_space_build_spec.md
/public/*_spec.md

# --- Spacebase CLI / marketplace SDK (not imported by Next.js runtime) ---
/marketplace/
/scripts/spacebase/
