# --- Supabase (required for production / shared portfolio; optional for local file-store dev) ---
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Note: Vercel production REQUIRES SUPABASE_SERVICE_ROLE_KEY — without it the dashboard shows zero programs.

# Optional: protect /api/admin/* (requires x-admin-api-key or Authorization: Bearer)
# ADMIN_API_KEY=your_admin_secret

# --- External APIs (ANTHROPIC_API_KEY required for all agent reasoning) ---
NCBI_API_KEY=your_key_here
SEMANTIC_SCHOLAR_API_KEY=your_key_here
# SEMANTIC_SCHOLAR_MIN_INTERVAL_MS=1100  # 1 req/sec limit with API key
OPENFDA_API_KEY=your_key_here
LENS_API_KEY=your_key_here
ANTHROPIC_API_KEY=your_key_here

# Optional: rate limit config
API_REQUEST_TIMEOUT_MS=10000
API_MAX_RETRIES=3

# Surveillance poll interval in ms (default 30000 for demo; use 86400000 for daily)
# NEXT_PUBLIC_SURVEILLANCE_POLL_MS=30000

# Spacebase1 intent space (Observatory live agent view — local only, set false on Vercel)
# SPACEBASE_ENABLED=false
# SPACEBASE_WORKSPACE=.spacebase/arclightbio
# SPACEBASE_AGENT_NAME=arclight
